# Port HTTP du serveur
PORT=3000

# Fichier SQLite (créé automatiquement)
DB_PATH=./data/smspay.db

# production | development
NODE_ENV=development

# Clé de chiffrement des secrets en base (64 caractères hexadécimaux = 32 octets).
# OBLIGATOIRE en production. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=

# Jeton pour les routes /admin (création de marchands, modèles de SMS).
# Laisser vide désactive les routes d'administration.
ADMIN_TOKEN=change-moi-avec-un-long-jeton-aleatoire

# Indicatif pays par défaut pour normaliser les numéros locaux (Burkina Faso = 226)
DEFAULT_COUNTRY_CODE=226

# Tolérance d'horloge pour les requêtes signées (secondes)
SIGNATURE_TOLERANCE_S=300

# Durée pendant laquelle un SMS dont le solde ne colle pas est "mis en attente"
# (le temps qu'un SMS arrivé dans le désordre vienne réparer la chaîne de soldes)
HOLD_SECONDS=120

# Délai sans signal de vie avant de considérer un téléphone hors ligne (secondes)
DEVICE_OFFLINE_AFTER_S=1800

# Fréquence des tâches de fond (expiration, webhooks, etc.) en millisecondes
WORKER_INTERVAL_MS=2000

# Tolérance entre l'horloge du téléphone et celle du serveur pour le rapprochement (secondes)
MATCH_CLOCK_SKEW_S=120

# Durée de validité par défaut d'une intention de paiement (secondes)
INTENT_DEFAULT_TTL_S=900

# Montant maximum accepté pour une intention de paiement (FCFA)
MAX_AMOUNT=2000000

# Délai max d'une requête webhook vers le marchand (ms)
WEBHOOK_TIMEOUT_MS=10000
