<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/relio_bg"
    android:orientation="vertical"
    tools:context=".ui.IncomingMessagesListFragment">

    <!-- Stats card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/statisticsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/relio_surface"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.12"
                android:text="@string/incoming_messages_status"
                android:textAllCaps="true"
                android:textColor="@color/relio_text_secondary"
                android:textSize="10sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/filterChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="0dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterAll"
                    style="@style/CompactFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Tous (0)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterSms"
                    style="@style/CompactFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="SMS (0)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterDataSms"
                    style="@style/CompactFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Data SMS (0)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/filterMms"
                    style="@style/CompactFilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="MMS (0)" />

            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_incoming_message" />

</LinearLayout>
