<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    app:cardBackgroundColor="@color/relio_surface"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Slot badge -->
        <TextView
            android:id="@+id/textSlot"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_status_chip"
            android:gravity="center"
            android:textColor="@color/relio_text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="1" />

        <!-- Carrier + number -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textCarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/relio_text_primary"
                android:textSize="14sp"
                tools:text="Orange" />

            <TextView
                android:id="@+id/textPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/ibm_plex_mono"
                android:textColor="@color/relio_text_secondary"
                android:textSize="12sp"
                tools:text="+22670000000" />
        </LinearLayout>

        <!-- Active indicator -->
        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_status_dot"
            android:backgroundTint="@color/relio_success" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
