<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    app:cardBackgroundColor="@color/relio_surface"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <!-- Priority icon + module label -->
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageViewPriority"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:scaleType="center"
                android:src="@drawable/ic_sms"
                app:tint="@color/relio_text_secondary" />

            <TextView
                android:id="@+id/textViewModule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/ibm_plex_mono"
                android:maxWidth="48dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/relio_accent"
                android:textSize="9sp"
                tools:text="core" />
        </LinearLayout>

        <!-- Message + date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textViewMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lines="2"
                android:textColor="@color/relio_text_primary"
                android:textSize="13sp"
                tools:text="Some description about what happened" />

            <TextView
                android:id="@+id/textViewDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/ibm_plex_mono"
                android:textColor="@color/relio_text_secondary"
                android:textSize="11sp"
                tools:text="2024-08-07 08:52" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
