<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/relio_bg"
    android:orientation="vertical">

    <!-- ─── Header ─────────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Opérateurs"
            android:textColor="@color/relio_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Connection badge -->
        <LinearLayout
            android:id="@+id/connectionBadge"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_status_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <View
                android:id="@+id/connectionDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_status_dot"
                android:backgroundTint="@color/relio_text_disabled" />

            <TextView
                android:id="@+id/connectionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/relio_text_secondary"
                android:textSize="12sp"
                tools:text="Connecté" />
        </LinearLayout>
    </LinearLayout>

    <!-- ─── SIM list ────────────────────────────────────────────────────────── -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="8dp"
        android:letterSpacing="0.12"
        android:text="CARTES SIM ACTIVES"
        android:textAllCaps="true"
        android:textColor="@color/relio_text_secondary"
        android:textSize="10sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerOperators"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="80dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_operator" />

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aucune SIM active"
            android:textColor="@color/relio_text_secondary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Vérifiez que les cartes SIM sont bien insérées\net que les permissions sont accordées"
            android:textColor="@color/relio_text_disabled"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
