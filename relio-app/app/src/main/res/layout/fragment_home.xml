<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/relio_bg"
    android:clipToPadding="false"
    android:paddingBottom="80dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp">

        <!-- ─── Header ─────────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/ibm_plex_mono"
                android:letterSpacing="0.1"
                android:text="relio"
                android:textColor="@color/relio_accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Status chip -->
            <LinearLayout
                android:id="@+id/statusChip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_status_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/bg_status_dot"
                    android:backgroundTint="@color/relio_text_disabled" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/relio_text_secondary"
                    android:textSize="12sp"
                    tools:text="Actif" />
            </LinearLayout>
        </LinearLayout>

        <!-- Device ID -->
        <TextView
            android:id="@+id/textDeviceId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/ibm_plex_mono"
            android:textColor="@color/relio_text_disabled"
            android:textSize="11sp"
            tools:text="dev_abc123" />

        <!-- ─── Queue card ──────────────────────────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/relio_surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="FILE D'ATTENTE"
                    android:textAllCaps="true"
                    android:textColor="@color/relio_text_secondary"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textPendingCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/ibm_plex_mono"
                        android:textColor="@color/relio_text_primary"
                        android:textSize="40sp"
                        tools:text="0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SMS\nen attente"
                        android:textColor="@color/relio_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/relio_border" />

                <!-- Queue status bar -->
                <ProgressBar
                    android:id="@+id/queueProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_marginTop="12dp"
                    android:indeterminate="false"
                    android:max="100"
                    android:progress="0"
                    android:progressTint="@color/relio_accent" />

                <TextView
                    android:id="@+id/textQueueStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/relio_text_secondary"
                    android:textSize="12sp"
                    tools:text="Relais actif — prêt à transmettre" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ─── SIM cards section ───────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.12"
            android:text="SIM ACTIVES"
            android:textAllCaps="true"
            android:textColor="@color/relio_text_secondary"
            android:textSize="10sp" />

        <!-- SIM list container -->
        <LinearLayout
            android:id="@+id/simCardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- Empty state -->
        <TextView
            android:id="@+id/textNoSim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Aucune SIM détectée"
            android:textColor="@color/relio_text_disabled"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- ─── Server section ──────────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:letterSpacing="0.12"
            android:text="SERVEUR"
            android:textAllCaps="true"
            android:textColor="@color/relio_text_secondary"
            android:textSize="10sp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/relio_surface"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="URL"
                        android:textColor="@color/relio_text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/textServerUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/ibm_plex_mono"
                        android:maxLines="1"
                        android:textColor="@color/relio_text_primary"
                        android:textSize="12sp"
                        tools:text="https://pay.exemple.com" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textConnectionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/relio_text_secondary"
                    android:textSize="11sp"
                    tools:text="Connecté" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <View android:layout_width="match_parent"
            android:layout_height="8dp" />

    </LinearLayout>

</ScrollView>
